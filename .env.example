#Server settings
GALLERY_NAME="Next Gallery"

HOST=www.waxworlds.org
PORT=8984
BASE_PATH="/dan/next_gallery"

# Configuration for the database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=next_gallery
DATABASE_PASSWORD=
DATABASE_NAME=next_gallery

# Next will load "API_*" on Server-only
API="http://localhost:8983"
API_GET_ALBUMS="/api/get_albums"
API_GET_IMAGES="/api/get_images"
API_GET_IMAGE="/api/get_image"

# Next wil load "NEXT_PUBLIC_*" in Browser as well as server
NEXT_PUBLIC_API_GET_IMAGE="/api/get_image"

#Logging
LOG_FILE=next_gallery.log
FILE_LOG_LEVEL=debug
CONSOLE_LOG_LEVEL=debug

#  Logging levels:
# 
#   Level    |   Priority
#   ---------|------------
#   error:   |   0,
#   warning: |   1,
#   info:    |   2,
#   debug:   |   3
