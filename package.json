{
  "name": "next_gallery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -c -- next dev",
    "build": "next build",
    "start": "dotenv -c -- next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "dotenv -c -- playwright test",
    "migrate:up": "dotenv -c -- tsx db/migrate.ts up",
    "migrate:down": "dotenv -c -- tsx db/migrate.ts down",
    "db:seed-admin": "dotenv -c -- tsx db/seed-admin.ts",
    "db:backup": "dotenv -c -- tsx db/dbBackup.ts",
    "db:restore": "dotenv -c -- tsx db/dbRestore.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "argon2": "^0.45.1",
    "base64url": "^3.0.1",
    "clsx": "^2.1.1",
    "directory-tree": "^3.6.0",
    "mysql2": "^3.24.4",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uniqid": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/uniqid": "^5.3.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "sass": "^1.103.1",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
